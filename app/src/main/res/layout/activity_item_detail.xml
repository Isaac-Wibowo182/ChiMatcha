<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F9">

    <androidx.cardview.widget.CardView
        android:id="@+id/headerCard"
        android:layout_width="418dp"
        android:layout_height="78dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="@android:color/transparent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/background_header"/>

        <ImageView
            android:layout_width="100dp"
            android:layout_height="68dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/logo"
            android:layout_marginTop="0dp"
            app:layout_constraintTop_toTopOf="@+id/headerCard"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/logout"
            android:layout_marginTop="10dp"
            android:layout_marginStart="350dp"/>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/imgProduct"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:src="@drawable/matcha_latte"
        android:scaleType="fitCenter"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Matcha Latte"
        android:textStyle="bold"
        android:textSize="28sp"
        android:textColor="#111111"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgProduct"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"/>

    <TextView
        android:id="@+id/txtDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="A refined blend of high-quality matcha and creamy milk, delivering a smooth, earthy, and calming flavor. Crafted with a perfectly balanced taste, making it an ideal choice for those seeking a premium beverage with a natural touch."
        android:textSize="16sp"
        android:textColor="#222222"
        android:lineSpacingExtra="5dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtIce"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ice Levels"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtDescription"
        app:layout_constraintStart_toStartOf="parent"/>

    <Spinner
        android:id="@+id/spinnerIce"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:background="#BCDB95"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtIce"
        app:layout_constraintStart_toStartOf="@id/txtIce"/>

    <TextView
        android:id="@+id/txtSweet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sweet Levels"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toEndOf="@id/spinnerIce"
        app:layout_constraintTop_toTopOf="@id/txtIce"/>

    <Spinner
        android:id="@+id/spinnerSweet"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:background="#BCDB95"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtSweet"
        app:layout_constraintStart_toStartOf="@id/txtSweet"/>

    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 32.000"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#2E7D32"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerIce"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btnOrder"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:text="Order Now"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="#2F3B2F"
        android:background="#BCDB95"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerSweet"
        app:layout_constraintStart_toStartOf="@id/spinnerSweet"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:cardBackgroundColor="#B9ECC7"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:src="@drawable/backitem"
            android:background="@android:color/transparent"
            android:layout_margin="10dp"
            android:paddingStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>